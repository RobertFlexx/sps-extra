name        gdk-pixbuf
version     2.42.12
release     1
description gdk-pixbuf: image loading library

source      https://download.gnome.org/sources/gdk-pixbuf/2.42/gdk-pixbuf-2.42.12.tar.xz
hash        sha256:b9505b3445b9a7e48ced34760c3bcb73e966df3ac94c95a148cb669ab748e3c7

depend      filesystem
depend      glib
depend      libpng
depend      libjpeg-turbo
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --buildtype=release -Dman=false -Dgtk_doc=false -Dintrospection=disabled -Dtests=false
build       meson compile -C build
install     DESTDIR="$PKG" meson install -C build --no-rebuild
