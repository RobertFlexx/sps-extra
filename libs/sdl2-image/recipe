name        sdl2-image
version     2.8.8
release     1
description sdl2-image: SDL2 image loading

source      https://github.com/libsdl-org/SDL_image/releases/download/release-2.8.8/SDL2_image-2.8.8.tar.gz
hash        sha256:2213b56fdaff2220d0e38c8e420cbe1a83c87374190cba8c70af2156097ce30a

depend      filesystem
depend      sdl2
depend      libpng
depend      libjpeg-turbo
depend      libwebp
depend      libtiff

configure   ./configure --prefix=/usr --libdir=/usr/lib64 --disable-static --disable-jpg-shared --disable-png-shared --disable-tif-shared --disable-webp-shared
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
