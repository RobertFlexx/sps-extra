name        yajl
version     2.1.0
release     2
description yajl: Yet Another JSON Library

# The repository carries both a tag and a branch named 2.1.0, so the short
# /archive/2.1.0.tar.gz form is ambiguous and GitHub answers it with
# "the given path has multiple possibilities" instead of a tarball. The
# refs/tags spelling is unambiguous.
source      https://github.com/lloyd/yajl/archive/refs/tags/${version}.tar.gz
hash        sha256:3fb73364a5a30efe615046d07e6db9d09fd2b41c763c5f7d3bfb121cd5c5ac5a

depend      filesystem
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
