name        libgit2
version     1.9.1
release     1
description libgit2: Git core library

source      https://github.com/libgit2/libgit2/archive/v1.9.1.tar.gz
hash        sha256:14cab3014b2b7ad75970ff4548e83615f74d719afe00aa479b4a889c1e13fc00

depend      filesystem
depend      openssl
depend      zlib
depend      libssh2
depend      pcre2
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DBUILD_TESTS=OFF -DUSE_SSH=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
