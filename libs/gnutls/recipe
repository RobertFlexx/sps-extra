name        gnutls
version     3.8.9
release     1
description gnutls: GNU TLS library

source      https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.9.tar.xz
hash        sha256:69e113d802d1670c4d5ac1b99040b1f2d5c7c05daec5003813c049b5184820ed

depend      filesystem
depend      nettle
depend      libtasn1
depend      p11-kit
depend      libunistring
depend      gmp

configure   ./configure --prefix=/usr --libdir=/usr/lib64 --disable-static --with-default-trust-store-file=/etc/ssl/certs/ca-certificates.crt --disable-guile --enable-ssl3-support=no
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
