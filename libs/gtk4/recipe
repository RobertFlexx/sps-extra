name        gtk4
version     4.18.6
release     1
description gtk4: GIMP Toolkit 4

source      https://download.gnome.org/sources/gtk/4.18/gtk-4.18.6.tar.xz
hash        sha256:e1817c650ddc3261f9a8345b3b22a26a5d80af154630dedc03cc7becefffd0fa

depend      filesystem
depend      glib
depend      cairo
depend      pango
depend      gdk-pixbuf
depend      graphene
depend      libepoxy
depend      wayland
depend      wayland-protocols
depend      libxkbcommon
depend      iso-codes
depend      fontconfig
depend      harfbuzz
depend      libpng
depend      libjpeg-turbo
depend      libtiff
depend      mesa
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release -Dintrospection=disabled -Dbuild-tests=false -Dbuild-testsuite=false -Dbuild-examples=false -Dbuild-demos=false -Ddocumentation=false -Dmedia-gstreamer=disabled -Dvulkan=disabled
build       meson compile -C build -j "$MAKEJOBS"
install     DESTDIR="$PKG" meson install -C build
