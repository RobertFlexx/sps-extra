name        chromaprint
version     1.5.1
release     1
description chromaprint: audio fingerprinting

source      https://github.com/acoustid/chromaprint/releases/download/v1.5.1/chromaprint-1.5.1.tar.gz
hash        sha256:a1aad8fa3b8b18b78d3755b3767faff9abb67242e01b478ec9a64e190f335e1c

depend      filesystem
depend      ffmpeg
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DBUILD_TOOLS=ON -DBUILD_TESTS=OFF
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
