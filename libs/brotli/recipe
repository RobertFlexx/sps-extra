name        brotli
version     1.1.0
release     1
description brotli: Brotli compression library

source      https://github.com/google/brotli/archive/v1.1.0.tar.gz
hash        sha256:e720a6ca29428b803f4ad165371771f5398faba397edf6778837a18599ea13ff

depend      filesystem
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
