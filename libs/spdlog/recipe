name        spdlog
version     1.15.3
release     1
description spdlog: C++ logging library

source      https://github.com/gabime/spdlog/archive/v1.15.3.tar.gz
hash        sha256:15a04e69c222eb6c01094b5c7ff8a249b36bb22788d72519646fb85feb267e67

depend      filesystem
depend      fmt
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DSPDLOG_FMT_EXTERNAL=ON -DSPDLOG_BUILD_EXAMPLE=OFF -DSPDLOG_BUILD_SHARED=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
