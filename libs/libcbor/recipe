name        libcbor
version     0.12.0
release     1
description libcbor: CBOR protocol implementation

source      https://github.com/PJK/libcbor/archive/v0.12.0.tar.gz
hash        sha256:5368add109db559f546d7ed10f440f39a273b073daa8da4abffc83815069fa7f

depend      filesystem
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DCBOR_CUSTOM_ALLOC=ON -DBUILD_SHARED_LIBS=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
