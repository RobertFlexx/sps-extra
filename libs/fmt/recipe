name        fmt
version     11.2.0
release     1
description fmt: C++ formatting library

source      https://github.com/fmtlib/fmt/archive/11.2.0.tar.gz
hash        sha256:bc23066d87ab3168f27cef3e97d545fa63314f5c79df5ea444d41d56f962c6af

depend      filesystem
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DFMT_TEST=OFF -DBUILD_SHARED_LIBS=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
