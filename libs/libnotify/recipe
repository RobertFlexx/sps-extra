name        libnotify
version     0.8.6
release     1
description libnotify: desktop notification library

source      https://download.gnome.org/sources/libnotify/0.8/libnotify-0.8.6.tar.xz
hash        sha256:c5540aaefb60e1d63b1c587c05f2284ebe72ece7d0c0e5e4a778cfd5844b6b58

depend      filesystem
depend      glib
depend      gdk-pixbuf
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release -Dman=false -Dgtk_doc=false -Dtests=false
build       meson compile -C build -j "$MAKEJOBS"
install     DESTDIR="$PKG" meson install -C build
