name        glm
version     1.0.1
release     1
arch        any
description glm: OpenGL Mathematics

source      https://github.com/g-truc/glm/archive/1.0.1.tar.gz
hash        sha256:9f3174561fd26904b23f0db5e560971cbf9b3cbda0b280f04d5c379d03bf234c

depend      filesystem
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DGLM_BUILD_TESTS=OFF -DBUILD_SHARED_LIBS=OFF
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
