builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release -Dtests=false -Dvk-proc-addr=enabled -Dglslang=disabled -Dshaderc=disabled -Dvulkan=enabled -Dopengl=disabled
build       meson compile -C build -j "$MAKEJOBS"
