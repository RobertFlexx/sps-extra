name        graphene
version     1.10.8
release     1
description graphene: thin-matrix library for GTK

source      https://download.gnome.org/sources/graphene/1.10/graphene-1.10.8.tar.xz
hash        sha256:a37bb0e78a419dcbeaa9c7027bcff52f5ec2367c25ec859da31dfde2928f279a

depend      filesystem
depend      glib
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release -Dintrospection=disabled -Dtests=false -Dinstalled_tests=false
build       meson compile -C build -j "$MAKEJOBS"
install     DESTDIR="$PKG" meson install -C build
