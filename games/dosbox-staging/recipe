name        dosbox-staging
version     0.82.2
release     1
description dosbox-staging: modern DOSBox fork

source      https://github.com/dosbox-staging/dosbox-staging/archive/v0.82.2.tar.gz
hash        sha256:387c97b373c3164ab5abbbc2b210bf94b5567057abe44ee1e8b4d4e725bd422c

depend      filesystem
depend      sdl2
depend      sdl2-net
depend      opus
depend      alsa-lib
depend      zlib
depend      libpng
depend      fluidsynth
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release -Duse_mt32emu=false
build       meson compile -C build -j "$MAKEJOBS"
install     DESTDIR="$PKG" meson install -C build
