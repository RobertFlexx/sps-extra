name        lua
version     5.4.8
release     2
description lua: lightweight programming language

source      https://www.lua.org/ftp/lua-5.4.8.tar.gz
hash        sha256:4f18ddae154e793e46eeab727c59ef1c0c0c2b744e7b94219710d76f530629ae

depend      filesystem
depend      readline
depend      ncurses

build       make -j"$MAKEJOBS" linux
install     make INSTALL_TOP="$PKG/usr" INSTALL_LIB="$PKG/usr/lib64" install
install     mkdir -p "$PKG/usr/lib64/pkgconfig"
install     printf '%s\n' 'prefix=/usr' 'exec_prefix=${prefix}' 'libdir=${prefix}/lib64' 'includedir=${prefix}/include' 'Name: Lua' 'Description: Lua 5.4' 'Version: 5.4.8' 'Libs: -L${libdir} -llua -lm -ldl' 'Cflags: -I${includedir}' >"$PKG/usr/lib64/pkgconfig/lua.pc"
install     ln -s lua.pc "$PKG/usr/lib64/pkgconfig/lua5.4.pc"
