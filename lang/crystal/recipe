name        crystal
version     1.17.1
release     1
description crystal: Crystal compiler (official linux-x86_64 distribution)

source      https://github.com/crystal-lang/crystal/releases/download/1.17.1/crystal-1.17.1-1-linux-x86_64.tar.gz
hash        sha256:0348317f19e924c954e14f2a0ddf2341b66dc207316b69197192fdb73abd581e

depend      filesystem

install     mkdir -p "$PKG/usr/lib/crystal" "$PKG/usr/bin"
install     cp -a . "$PKG/usr/lib/crystal/"
install     if [ -x bin/crystal ]; then ln -s ../lib/crystal/bin/crystal "$PKG/usr/bin/crystal"; elif [ -x crystal ]; then ln -s ../lib/crystal/crystal "$PKG/usr/bin/crystal"; fi
install     if [ -x bin/shards ]; then ln -s ../lib/crystal/bin/shards "$PKG/usr/bin/shards"; fi
