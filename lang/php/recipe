name        php
version     8.4.12
release     2
description php: PHP interpreter

source      https://www.php.net/distributions/php-8.4.12.tar.xz
hash        sha256:c1b7978cbb5054eed6c749bde4444afc16a3f2268101fb70a7d5d9b1083b12ad

depend      filesystem
depend      openssl
depend      zlib
depend      sqlite
depend      libxml2
depend      libffi
depend      ncurses
depend      readline
depend      bzip2
depend      xz

configure   ./configure --prefix=/usr --libdir=/usr/lib64 --sysconfdir=/etc --with-openssl --with-zlib --with-bz2 --with-sqlite3 --enable-mbstring --with-readline --disable-cgi --enable-cli --without-pear --disable-phpdbg
build       make -j"$MAKEJOBS"
install     make install INSTALL_ROOT="$PKG"
