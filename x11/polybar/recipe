name        polybar
version     3.7.2
release     1
description polybar: fast status bar

source      https://github.com/polybar/polybar/releases/download/3.7.2/polybar-3.7.2.tar.gz
hash        sha256:e2feacbd02e7c94baed7f50b13bcbf307d95df0325c3ecae443289ba5b56af29

depend      filesystem
depend      cairo
depend      libxcb
depend      xcb-util-image
depend      xcb-util-wm
depend      xcb-util
depend      alsa-lib
depend      libuv
depend      python
depend      freetype
depend      fontconfig
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
