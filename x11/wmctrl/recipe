name        wmctrl
version     1.07
release     2
description wmctrl: control EWMH window managers

# Upstream only ever published this on sites.google.com, which now answers
# every request with a Google account sign-in page instead of the tarball.
# Debian carries the unmodified 1.07 release.
source      https://deb.debian.org/debian/pool/main/w/wmctrl/wmctrl_${version}.orig.tar.gz
hash        sha256:d78a1efdb62f18674298ad039c5cbdb1edb6e8e149bb3a8e3a01a4750aa3cca9

depend      filesystem
depend      libx11
depend      libxmu
depend      glib

configure   ./configure --prefix=/usr
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
