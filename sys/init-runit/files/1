#!/bin/sh
PATH=/usr/bin:/usr/sbin:/bin:/sbin
export PATH
mount -t proc proc /proc 2>/dev/null || :
mount -t sysfs sysfs /sys 2>/dev/null || :
mount -t devtmpfs devtmpfs /dev 2>/dev/null || :
mkdir -p /dev/pts /dev/shm /run
mount -t devpts devpts /dev/pts 2>/dev/null || :
mount -t tmpfs shm /dev/shm 2>/dev/null || :
mount -t tmpfs tmpfs /run 2>/dev/null || :
if [ -r /etc/hostname ]; then
	hostname "$(cat /etc/hostname)" 2>/dev/null || :
fi
if [ -x /sbin/udevd ] || [ -x /usr/sbin/udevd ]; then
	udevd --daemon 2>/dev/null || /usr/sbin/udevd --daemon 2>/dev/null || :
	udevadm trigger --action=add 2>/dev/null || :
	udevadm settle --timeout=8 2>/dev/null || :
fi
