name        sysvinit
version     3.14
release     1
description sysvinit: System V style init
source      https://github.com/slicer69/sysvinit/releases/download/3.14/sysvinit-3.14.tar.xz
hash        sha256:c90874b8c054a35991fb8c4d30c443ed1e9b1815ff6165c7b483f558be4e4b53
depend      filesystem
conflict    systemd
conflict    openrc
conflict    s6
conflict    runit
conflict    dinit
conflict    shepherd
build       make -C src -j"$MAKEJOBS"
install     make -C src ROOT="$PKG" install
install     mkdir -p "$PKG/etc/sps"
install     printf '%s\n' sysvinit >"$PKG/etc/sps/init"
