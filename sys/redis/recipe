name        redis
version     7.4.5
release     2
description redis: in-memory data store

source      https://github.com/redis/redis/archive/7.4.5.tar.gz
hash        sha256:86d5d833855dfa57c6f42ff6b9b7983f08d47fb014a9489c3182462d5546fbfa

depend      filesystem
depend      openssl

build       make -j"$MAKEJOBS" PREFIX=/usr BUILD_TLS=yes
install     make PREFIX=/usr DESTDIR="$PKG" install
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d" "$PKG/etc/sv/redis" "$PKG/etc/s6/sv/redis" "$PKG/etc/dinit.d" "$PKG/etc/shepherd.d" "$PKG/etc/rc.d/init.d"
install     install -m 0644 "$SRC/files/redis.service" "$PKG/usr/lib/systemd/system/redis.service"
install     install -m 0755 "$SRC/files/openrc-redis" "$PKG/etc/init.d/redis"
install     install -m 0755 "$SRC/files/runit-redis" "$PKG/etc/sv/redis/run"
install     install -m 0755 "$SRC/files/s6-redis" "$PKG/etc/s6/sv/redis/run"
install     install -m 0644 "$SRC/files/dinit-redis" "$PKG/etc/dinit.d/redis"
install     install -m 0644 "$SRC/files/shepherd-redis.scm" "$PKG/etc/shepherd.d/redis.scm"
install     install -m 0755 "$SRC/files/sysvinit-redis" "$PKG/etc/rc.d/init.d/redis"
