name        qt6-qtbase
version     6.11.2
release     1
description qt6-qtbase: Qt 6 module

source      https://download.qt.io/official_releases/qt/6.11/6.11.2/submodules/qtbase-everywhere-src-6.11.2.tar.xz
hash        sha256:5b2e00eccaf5a4d8c14134ffa0ea8dfd0a35ae1ffc7f8d87fa4305a1ed23cf22

depend      filesystem
depend      pkgconf
depend      zlib
depend      openssl
depend      libpng
depend      freetype
depend      fontconfig
depend      harfbuzz
depend      glib
depend      dbus
depend      libxkbcommon
depend      x11
depend      mesa
depend      wayland
depend      wayland-protocols
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DQT_BUILD_TESTS=OFF -DQT_FEATURE_system_zlib=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
