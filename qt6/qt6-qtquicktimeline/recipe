name        qt6-qtquicktimeline
version     6.11.2
release     1
description qt6-qtquicktimeline: Qt 6 module

source      https://download.qt.io/official_releases/qt/6.11/6.11.2/submodules/qtquicktimeline-everywhere-src-6.11.2.tar.xz
hash        sha256:250af10500a0c4045dde74e107448a69a44d58af8b7e9a91704a808d5f881d17

depend      filesystem
depend      qt6-qtbase
depend      pkgconf
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DQT_BUILD_TESTS=OFF -DQT_FEATURE_system_zlib=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
