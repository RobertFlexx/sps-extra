name        qt6-qtshadertools
version     6.11.2
release     1
description qt6-qtshadertools: Qt 6 module

source      https://download.qt.io/official_releases/qt/6.11/6.11.2/submodules/qtshadertools-everywhere-src-6.11.2.tar.xz
hash        sha256:805046b8b7757665586890b375940047e874ae3ab00adb6d3f2b38fc6b200b1c

depend      filesystem
depend      qt6-qtbase
depend      pkgconf
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DQT_BUILD_TESTS=OFF -DQT_FEATURE_system_zlib=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
