name        qt6-qtwebengine
version     6.11.2
release     1
description qt6-qtwebengine: Chromium-based Qt web engine and Qt Pdf

source      https://download.qt.io/official_releases/qt/6.11/6.11.2/submodules/qtwebengine-everywhere-src-6.11.2.tar.xz
hash        sha256:6101c1aa00ff933d1b65ee5d167f76e8d71b9ac5b378b0111277723ebda7c163

depend      filesystem
depend      qt6-qtbase
depend      qt6-qtdeclarative
depend      qt6-qtwebchannel
depend      qt6-qtpositioning
depend      qt6-qttools
depend      icu
depend      libevent
depend      libxml2
depend      libxslt
depend      nss
depend      nspr
depend      alsa-lib
depend      mesa
depend      libdrm
depend      libxcomposite
depend      libxdamage
depend      libxext
depend      libxfixes
depend      libxkbfile
depend      libxrandr
depend      libxtst
depend      libxscrnsaver
depend      pciutils
depend      dbus
depend      fontconfig
depend      freetype
depend      harfbuzz
depend      libjpeg-turbo
depend      libpng
depend      zlib
depend      opus
depend      libvpx
depend      libwebp
depend      snappy
depend      re2
depend      minizip-ng
depend      libcap
depend      pipewire
builddep    cmake
builddep    ninja
builddep    python
builddep    nodejs
builddep    gperf
builddep    bison
builddep    flex
builddep    pkgconf

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DQT_BUILD_TESTS=OFF -DQT_FEATURE_qtwebengine_build=ON -DQT_FEATURE_qtpdf_build=ON -DQT_FEATURE_webengine_system_icu=ON -DQT_FEATURE_webengine_system_libevent=ON -DQT_FEATURE_webengine_system_libpng=ON -DQT_FEATURE_webengine_system_libjpeg=ON -DQT_FEATURE_webengine_system_zlib=ON -DQT_FEATURE_webengine_system_harfbuzz=ON -DQT_FEATURE_webengine_system_freetype=ON -DQT_FEATURE_webengine_system_libxml=ON -DQT_FEATURE_webengine_proprietary_codecs=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
