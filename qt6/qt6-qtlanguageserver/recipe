name        qt6-qtlanguageserver
version     6.11.2
release     1
description qt6-qtlanguageserver: Qt 6 module

source      https://download.qt.io/official_releases/qt/6.11/6.11.2/submodules/qtlanguageserver-everywhere-src-6.11.2.tar.xz
hash        sha256:38bc4272ecf4ca0eb1927227053e52be6b2e05733f46d03422306aace511fc5e

depend      filesystem
depend      qt6-qtbase
depend      pkgconf
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DQT_BUILD_TESTS=OFF -DQT_FEATURE_system_zlib=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
