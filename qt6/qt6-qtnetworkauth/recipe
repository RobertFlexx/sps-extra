name        qt6-qtnetworkauth
version     6.11.2
release     1
description qt6-qtnetworkauth: Qt 6 module

source      https://download.qt.io/official_releases/qt/6.11/6.11.2/submodules/qtnetworkauth-everywhere-src-6.11.2.tar.xz
hash        sha256:0c83c23077ab7824393fa15bb0015c3c5acaf5678544aa789e3fcbb4d41fa05b

depend      filesystem
depend      qt6-qtbase
depend      pkgconf
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DQT_BUILD_TESTS=OFF -DQT_FEATURE_system_zlib=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
