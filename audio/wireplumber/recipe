name        wireplumber
version     0.5.10
release     2
description wireplumber: PipeWire session manager

source      https://gitlab.freedesktop.org/pipewire/wireplumber/-/archive/0.5.10/wireplumber-0.5.10.tar.gz
hash        sha256:c2e021d8e6ef1db644facd4a97f5a644b67481c641da9100e851aab6752ba446

depend      filesystem
depend      pipewire
depend      glib
depend      lua

configure   meson setup build --prefix=/usr --buildtype=release -Dintrospection=disabled -Ddoc=disabled -Dtests=false
build       meson compile -C build
install     DESTDIR="$PKG" meson install -C build --no-rebuild
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d" "$PKG/etc/sv/wireplumber" "$PKG/etc/s6/sv/wireplumber" "$PKG/etc/dinit.d" "$PKG/etc/shepherd.d" "$PKG/etc/rc.d/init.d"
install     install -m 0644 "$SRC/files/wireplumber.service" "$PKG/usr/lib/systemd/system/wireplumber.service"
install     install -m 0755 "$SRC/files/openrc-wireplumber" "$PKG/etc/init.d/wireplumber"
install     install -m 0755 "$SRC/files/runit-wireplumber" "$PKG/etc/sv/wireplumber/run"
install     install -m 0755 "$SRC/files/s6-wireplumber" "$PKG/etc/s6/sv/wireplumber/run"
install     install -m 0644 "$SRC/files/dinit-wireplumber" "$PKG/etc/dinit.d/wireplumber"
install     install -m 0644 "$SRC/files/shepherd-wireplumber.scm" "$PKG/etc/shepherd.d/wireplumber.scm"
install     install -m 0755 "$SRC/files/sysvinit-wireplumber" "$PKG/etc/rc.d/init.d/wireplumber"
