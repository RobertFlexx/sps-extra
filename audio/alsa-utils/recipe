name        alsa-utils
version     1.2.16
release     3
description alsa-utils: ALSA utilities

source      https://www.alsa-project.org/files/pub/utils/alsa-utils-1.2.16.tar.bz2
hash        sha256:092399d5e8749a1d5e188e393157521cec4b75693b60ebb79bbce728cff2232c

depend      filesystem
depend      alsa-lib
depend      ncurses

configure   ./configure --prefix=/usr --libdir=/usr/lib64 \
            --with-alsa-prefix="$SPS_ROOT/usr/lib64" \
            --with-alsa-inc-prefix="$SPS_ROOT/usr/include"
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
