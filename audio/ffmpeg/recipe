name        ffmpeg
version     8.0
release     1
description ffmpeg: audio and video toolkit

source      https://ffmpeg.org/releases/ffmpeg-8.0.tar.xz
hash        sha256:b2751fccb6cc4c77708113cd78b561059b6fa904b24162fa0be2d60273d27b8e

depend      filesystem
