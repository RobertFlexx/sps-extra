name        knighttime
version     6.7.4
release     1
description knighttime: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/knighttime-6.7.4.tar.xz
hash        sha256:df367488f087897156523ea98cd239297642de10e5e053b8e7255e94e7935ede

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
