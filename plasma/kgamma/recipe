name        kgamma
version     6.7.4
release     1
description kgamma: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kgamma-6.7.4.tar.xz
hash        sha256:b08d2eba7148677980d3b607b240ffc70b5ed0ae1449457290be5e5b11b3d886

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
