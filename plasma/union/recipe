name        union
version     6.7.4
release     1
description union: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/union-6.7.4.tar.xz
hash        sha256:b1a83dc6b831fb3e46d18d4c6441822c94e386299ef37b816148215480d325ac

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
