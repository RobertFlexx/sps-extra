name        flatpak-kcm
version     6.7.4
release     1
description flatpak-kcm: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/flatpak-kcm-6.7.4.tar.xz
hash        sha256:1133b40e4d7fad2349a84b5e0f12acaaa22a0940fa4fc1500e2c79482535e219

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
