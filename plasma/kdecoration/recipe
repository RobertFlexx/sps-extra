name        kdecoration
version     6.7.4
release     1
description kdecoration: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kdecoration-6.7.4.tar.xz
hash        sha256:af366baba8694e16226844a94b4772a63a7e8d8d43e4c1950215eb163b4ca590

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
