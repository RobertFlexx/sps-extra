name        kdeplasma-addons
version     6.7.4
release     1
description kdeplasma-addons: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kdeplasma-addons-6.7.4.tar.xz
hash        sha256:5098c28b7e4e0c1c9320db28c2e778f3ecd5c62d655c95983993f66003980ec1

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
