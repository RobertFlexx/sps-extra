name        plasma-systemmonitor
version     6.7.4
release     1
description plasma-systemmonitor: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-systemmonitor-6.7.4.tar.xz
hash        sha256:80694f9d683a3720116197f7899e47a0b10f01a46a66af65ee079e2145897a8d

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
