name        plasma-workspace-wallpapers
version     6.7.4
release     1
description plasma-workspace-wallpapers: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-workspace-wallpapers-6.7.4.tar.xz
hash        sha256:d0bab9b0182480a41fe0c677a1f5d4d1c3088e0f3aa6883a0bc25423d94ecfd0

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
