name        polkit-kde-agent
version     6.7.4
release     1
description polkit-kde-agent: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/polkit-kde-agent-1-6.7.4.tar.xz
hash        sha256:d80699575c08824af81fc0e2adc1c48c5e9aa466a9b80bc296e0394936736e0a

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
