name        plasma5support
version     6.7.4
release     1
description plasma5support: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma5support-6.7.4.tar.xz
hash        sha256:793fd67604547f34c6ecc89104c9d39c56d388b6b73181302e5c8d775782e6dd

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
