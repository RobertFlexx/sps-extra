name        plasma-vault
version     6.7.4
release     1
description plasma-vault: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-vault-6.7.4.tar.xz
hash        sha256:6f18b85c9bda68cc271a90d2f275bfad414f588825c32431e26b843f8fc57113

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
