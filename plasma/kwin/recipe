name        kwin
version     6.7.4
release     1
description kwin: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kwin-6.7.4.tar.xz
hash        sha256:db7a7dba71aaca1e5218733b80f90a998d84e2ab36e4d62d0e3ea00376c5802d

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
