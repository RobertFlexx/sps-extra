name        discover
version     6.7.4
release     1
description discover: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/discover-6.7.4.tar.xz
hash        sha256:f8b809c9aaa25c1d636b0bdf144d87a3ee659d5d80f26961d3116a627fef859d

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
