name        xdg-desktop-portal-kde
version     6.7.4
release     1
description xdg-desktop-portal-kde: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/xdg-desktop-portal-kde-6.7.4.tar.xz
hash        sha256:bb4b955e2f52a832f221d3fb7182cebf920653a0ad1e3201abd29f134d4c33f3

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
