name        kwallet-pam
version     6.7.4
release     1
description kwallet-pam: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kwallet-pam-6.7.4.tar.xz
hash        sha256:24430ef5bef8b7c06b8f6770058afaab8fbbc166392535408b4e1d9e99a1ca9c

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
