name        libplasma
version     6.7.4
release     1
description libplasma: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/libplasma-6.7.4.tar.xz
hash        sha256:8f187850ea0cd46e545b33787619fa28f682388e4b828d090a0692874a7c9955

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
