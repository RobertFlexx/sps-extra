name        plasma-thunderbolt
version     6.7.4
release     1
description plasma-thunderbolt: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-thunderbolt-6.7.4.tar.xz
hash        sha256:cc40625fc51d1d1576e02e7411f2426fef61f78ff6e7bc14db3f2818032a5309

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
