name        spectacle
version     6.7.4
release     1
description spectacle: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/spectacle-6.7.4.tar.xz
hash        sha256:5c61ffd9b37ca6384b754d44a051c8f979ab77984f92e7ddf3a1c15156d65665

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
