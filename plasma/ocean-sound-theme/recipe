name        ocean-sound-theme
version     6.7.4
release     1
description ocean-sound-theme: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/ocean-sound-theme-6.7.4.tar.xz
hash        sha256:3d0368e992388fce0015e3622778062a67827b660bae6ab551e873ae18a3045c

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
