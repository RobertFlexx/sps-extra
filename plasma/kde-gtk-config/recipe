name        kde-gtk-config
version     6.7.4
release     1
description kde-gtk-config: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kde-gtk-config-6.7.4.tar.xz
hash        sha256:52eab1e9f71e0a92d542ee1cc655895ed4b999a9e394d468f4ef2c838f0c739b

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
