name        kwayland-integration
version     6.7.4
release     1
description kwayland-integration: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kwayland-integration-6.7.4.tar.xz
hash        sha256:81f0e65271648c612c6899a7d2d3a0d17b77896de096934e0e793b1337546282

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
