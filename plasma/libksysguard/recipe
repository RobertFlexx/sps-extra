name        libksysguard
version     6.7.4
release     1
description libksysguard: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/libksysguard-6.7.4.tar.xz
hash        sha256:3882fe735a00113d6fc754d5d425703bab42b6bbbff16788e95adb4ef11bb04c

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
