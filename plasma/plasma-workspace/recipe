name        plasma-workspace
version     6.7.4
release     1
description plasma-workspace: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-workspace-6.7.4.tar.xz
hash        sha256:21ec3c002929eb65377a1ae0eb105b9ab6f608049dac5493e188f51bd50398d5

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
