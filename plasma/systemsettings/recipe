name        systemsettings
version     6.7.4
release     1
description systemsettings: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/systemsettings-6.7.4.tar.xz
hash        sha256:5a254bcf7cbeed04ee3f407b5e86609992f978d8734e76fa24b4afafbd66383c

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
