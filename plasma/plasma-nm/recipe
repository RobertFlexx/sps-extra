name        plasma-nm
version     6.7.4
release     1
description plasma-nm: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-nm-6.7.4.tar.xz
hash        sha256:c4d49e08072510ed1d2ea9e124dcf493a86458391c756d14aaac28c2c0a7e484

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
