name        print-manager
version     6.7.4
release     1
description print-manager: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/print-manager-6.7.4.tar.xz
hash        sha256:4bce095c6dc9607b20551b0ea5c5ebcb56a49510ee0c02d344572604d7416868

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
