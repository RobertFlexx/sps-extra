name        plasma-sdk
version     6.7.4
release     1
description plasma-sdk: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-sdk-6.7.4.tar.xz
hash        sha256:9c97c3efd821e8bd214f1d393e1f9b26242aab9b8099146d37eaaddf09d91070

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
