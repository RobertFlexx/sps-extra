name        kwayland
version     6.7.4
release     1
description kwayland: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kwayland-6.7.4.tar.xz
hash        sha256:2cb3ad260a0fc07533b1e0e9e294da2ec9be83095a901140e9fab16fa17a550d

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
