name        krdp
version     6.7.4
release     1
description krdp: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/krdp-6.7.4.tar.xz
hash        sha256:dd952892bfafd06281fd9fd239fb5f3b5807f3f346be456554061183881abf8b

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
