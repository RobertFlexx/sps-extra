name        aurorae
version     6.7.4
release     1
description aurorae: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/aurorae-6.7.4.tar.xz
hash        sha256:b1ceea196fc95adb141917e230fb2609920d420a9db2451eb8a69039b4c96623

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
