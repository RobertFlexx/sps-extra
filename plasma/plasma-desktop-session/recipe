name        plasma-desktop-session
version     6.7.4
release     1
description plasma-desktop-session: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-desktop-6.7.4.tar.xz
hash        sha256:c2f0c2b7ab70cbd99ef17ffad4c3117dab12ef6a71790da33e39688386474962

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
