name        plasma-pa
version     6.7.4
release     1
description plasma-pa: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-pa-6.7.4.tar.xz
hash        sha256:419c3cfe15f2f3093c4255d84a24708dd7ad28da2ce80cfee3521f761ba6937e

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
