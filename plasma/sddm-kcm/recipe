name        sddm-kcm
version     6.7.4
release     1
description sddm-kcm: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/sddm-kcm-6.7.4.tar.xz
hash        sha256:e29498674bf54140dfec8480186cdd0da515a2e6292c733208adeb4175512969

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
