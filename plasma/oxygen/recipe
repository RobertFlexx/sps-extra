name        oxygen
version     6.7.4
release     1
description oxygen: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/oxygen-6.7.4.tar.xz
hash        sha256:9e64ac80a01ed904110b88232e509c7ae920d6d8b1202880ff557e5c621919af

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
