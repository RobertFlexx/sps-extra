name        wacomtablet
version     6.7.4
release     1
description wacomtablet: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/wacomtablet-6.7.4.tar.xz
hash        sha256:236c67147b2da701e42bd9e3ea99cc444e0615393d020e029083c04acd586569

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
