name        breeze
version     6.7.4
release     1
description breeze: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/breeze-6.7.4.tar.xz
hash        sha256:31dc88f924a5f5c979f09275ccc897cb0001bda45604561c8f18eb35b2e38b5a

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
