name        plasma-welcome
version     6.7.4
release     2
description plasma-welcome: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/plasma-welcome-6.7.4.tar.xz
hash        sha256:d9862440a16820ca00abb22363be57e9b156adc76db692d4d04cabd3e862ab3d

depend      filesystem
depend      qt6
depend      kf6
depend      splux-base
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
