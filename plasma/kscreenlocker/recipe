name        kscreenlocker
version     6.7.4
release     1
description kscreenlocker: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kscreenlocker-6.7.4.tar.xz
hash        sha256:f9cd525d501f08931f2c0b4d08f5384588967bc89fac62e39ed4ae2da2925a39

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
