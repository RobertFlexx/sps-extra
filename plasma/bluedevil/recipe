name        bluedevil
version     6.7.4
release     1
description bluedevil: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/bluedevil-6.7.4.tar.xz
hash        sha256:8a3bb7d3005b0a01af171bdb41bececd5848de75c4a4d68d399a49c517791652

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
