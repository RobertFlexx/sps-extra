name        kpipewire
version     6.7.4
release     1
description kpipewire: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kpipewire-6.7.4.tar.xz
hash        sha256:2020a6a94bb7726ec68004c7946ad7f6ed450dcee8f4e8b710c3680755afb1ab

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
