name        ksshaskpass
version     6.7.4
release     1
description ksshaskpass: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/ksshaskpass-6.7.4.tar.xz
hash        sha256:d3843061584f25269771b2cf72ba4a930f6b21e3da697b0ef9d569a99e995c67

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
