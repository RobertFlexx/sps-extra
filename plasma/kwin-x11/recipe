name        kwin-x11
version     6.7.4
release     1
description kwin-x11: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kwin-x11-6.7.4.tar.xz
hash        sha256:2c471ec076532b657a101761a3505ae4521aca3d90c86d783c813f42622a1e2e

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
