name        kde-cli-tools
version     6.7.4
release     1
description kde-cli-tools: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/kde-cli-tools-6.7.4.tar.xz
hash        sha256:9b93730cbea9eecd2b17c84603c1496d18d08749d2861f87a7552f463d7aecb0

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
