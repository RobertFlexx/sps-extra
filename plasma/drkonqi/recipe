name        drkonqi
version     6.7.4
release     1
description drkonqi: KDE component

source      https://download.kde.org/stable/plasma/6.7.4/drkonqi-6.7.4.tar.xz
hash        sha256:c7f9402b7a32e077b23d34d083926bc7a78f18b93184510def3fcc32532d6959

depend      filesystem
depend      qt6
depend      kf6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
