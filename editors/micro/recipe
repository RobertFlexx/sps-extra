name        micro
version     2.0.15
release     1
description micro: terminal editor

source      https://github.com/zyedidia/micro/archive/refs/tags/v2.0.15.tar.gz
hash        sha256:612c775321c268c8f9e1767505ff378bca9b9ab66f5c41b69ecb2464ecf15084

depend      filesystem

builddep    go
build       GOPROXY=https://proxy.golang.org,direct CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o micro ./cmd/micro
install     mkdir -p "$PKG/usr/bin"
install     cp micro "$PKG/usr/bin/micro"
install     chmod 755 "$PKG/usr/bin/micro"
