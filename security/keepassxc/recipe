name        keepassxc
version     2.7.10
release     1
description keepassxc: password manager

source      https://github.com/keepassxreboot/keepassxc/releases/download/2.7.10/keepassxc-2.7.10-src.tar.xz
hash        sha256:5ce76d6440986c24842585f019d5f3cadc166fa71fc911a4fe97b8bbc4819dfa

depend      filesystem
depend      qt6-qtbase
depend      qt6-qtsvg
depend      libargon2
depend      libsodium
depend      qrencode
depend      minizip-ng
depend      zlib
depend      readline
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DWITH_XC_AUTOTYPE=ON -DWITH_XC_YUBIKEY=OFF -DWITH_XC_KEESHARE=ON -DWITH_XC_NETWORKING=ON -DWITH_XC_BROWSER=OFF -DWITH_TESTS=OFF
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
