name        pinentry-qt
version     1.3.1
release     1
description pinentry-qt: Qt PIN entry dialog

source      https://www.gnupg.org/ftp/gcrypt/pinentry/pinentry-1.3.1.tar.bz2
hash        sha256:bc72ee27c7239007ab1896c3c2fae53b076e2c9bd2483dc2769a16902bce8c04

depend      filesystem
depend      libassuan
depend      libgpg-error
depend      qt6-qtbase
depend      libsecret

configure   ./configure --prefix=/usr --enable-pinentry-qt --disable-inside-emacs --disable-pinentry-gtk2 --disable-pinentry-gnome3 --disable-pinentry-tqt --disable-pinentry-fltk
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
