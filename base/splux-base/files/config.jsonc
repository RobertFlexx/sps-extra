{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "splux.txt",
        "color": {
            "1": "light_black",
            "2": "light_yellow"
        },
        "padding": {
            "top": 7,
            "right": 4
        }
    },
    "display": {
        "color": {
            "keys": "light_black"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "light_black",
                "at": "light_black",
                "host": "light_yellow"
            }
        },
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        {
            "type": "packages",
            "combined": true
        },
        "shell",
        "display",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "locale"
    ]
}
