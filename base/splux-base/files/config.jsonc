{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "splux.txt",
        "color": {
            "1": "1;38;2;255;255;0",
            "2": "1;38;2;255;255;255"
        },
        "padding": {
            "top": 1,
            "right": 4
        }
    },
    "display": {
        "color": {
            "keys": "1;38;2;255;255;255",
            "title": "1;38;2;255;255;255",
            "output": "1;38;2;255;255;255",
            "separator": "1;38;2;255;255;255"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        {
            "type": "packages",
            "combined": true
        },
        "shell",
        "display",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "locale"
    ]
}
