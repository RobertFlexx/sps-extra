name        filelight
version     26.08.0
release     1
description filelight: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/filelight-26.08.0.tar.xz
hash        sha256:029ab28cdc6615d2e50741334d1fd29ceb119184019d0d566dce82f65f8d135f

depend      filesystem
depend      qt6
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
