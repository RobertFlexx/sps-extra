name        okular
version     26.08.0
release     1
description okular: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/okular-26.08.0.tar.xz
hash        sha256:235e8e761f949b81953582e3ff6e45b8832d0d551b71bd1b5098c1ad663511e4

depend      filesystem
depend      qt6
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
