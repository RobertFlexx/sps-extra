name        khelpcenter
version     26.08.0
release     1
description khelpcenter: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/khelpcenter-26.08.0.tar.xz
hash        sha256:11c8e13960e4ef655d4d9a1b909baf3e6aa85d9b96b6b657a220d092d5bbd2df

depend      filesystem
depend      qt6
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
