name        gwenview
version     26.08.0
release     1
description gwenview: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/gwenview-26.08.0.tar.xz
hash        sha256:f7381e0ce16c67280a374d3b02799f7caced1e1c7640136945db9a75f12dcbcf

depend      filesystem
depend      qt6
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
