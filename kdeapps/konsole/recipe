name        konsole
version     26.08.0
release     1
description konsole: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/konsole-26.08.0.tar.xz
hash        sha256:19d909a6f18440b28dc6492e97172aa070a3ac425d94d8bbb89a01979a2ce666

depend      filesystem
depend      qt6
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
