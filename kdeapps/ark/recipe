name        ark
version     26.08.0
release     1
description ark: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/ark-26.08.0.tar.xz
hash        sha256:d4627791d17d17f0c4472f8bc464778d7b5526adeca9bba27565e77ff8b44db7

depend      filesystem
depend      qt6
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
