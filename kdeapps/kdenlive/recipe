name        kdenlive
version     26.08.0
release     1
description kdenlive: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/kdenlive-26.08.0.tar.xz
hash        sha256:754e1b3e288f8529b2739cfe8ce702d3880f3f3239b0d73f2aef2c88aca49b12

depend      filesystem
depend      qt6
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
