name        falkon
version     26.08.0
release     2
description falkon: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/falkon-26.08.0.tar.xz
hash        sha256:0a2d159b4f512c88557ab8556f550c7b5492437154e6729bfee12907d178f0c3

depend      filesystem
depend      qt6
depend      qt6-qtwebengine
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
