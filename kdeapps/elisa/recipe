name        elisa
version     26.08.0
release     1
description elisa: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/elisa-26.08.0.tar.xz
hash        sha256:0808766fda2d11274cca943bfed2347d89e7a85225e0606bb724eb6d50f0a434

depend      filesystem
depend      qt6
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
