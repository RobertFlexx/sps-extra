name        yakuake
version     26.08.0
release     1
description yakuake: KDE component

source      https://download.kde.org/stable/release-service/26.08.0/src/yakuake-26.08.0.tar.xz
hash        sha256:7ce707aa3609a318bd65533b3fc0a8cbcb1713372a8b769bf09876f51652686e

depend      filesystem
depend      qt6
depend      kf6
depend      plasma-desktop
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
