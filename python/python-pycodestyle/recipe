name        python-pycodestyle
version     2.14.0
release     1
arch        any
description python-pycodestyle: Python style guide checker

source      https://files.pythonhosted.org/packages/11/e0/abfd2a0d2efe47670df87f3e3a0e2edda42f055053c85361f19c0e2c1ca8/pycodestyle-${version}.tar.gz
hash        sha256:c4b5b517d278089ff9d0abdec919cd97262a3367449ea1c8b49b91529167b783

depend      filesystem
depend      python
builddep    python-setuptools

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
