name        python-pygments-better-html
version     0.1.6
release     1
arch        any
description python-pygments-better-html: Better HTML formatter for Pygments

source      https://files.pythonhosted.org/packages/7d/24/b7006b8537def51c771efa81839ef8435e681c4e13d35e3f4b60cebce4ec/pygments_better_html-${version}.tar.gz
hash        sha256:3821d9e2dcf402cd319edca6f893f3e8a399c42d096ab02a16155b8c3de4d888

depend      filesystem
depend      python
depend      python-pygments
builddep    python-flit-core

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
