name        python-referencing
version     0.37.0
release     1
arch        any
description python-referencing: JSON Referencing + Python

source      https://files.pythonhosted.org/packages/22/f5/df4e9027acead3ecc63e50fe1e36aca1523e1719559c499951bb4b53188f/referencing-${version}.tar.gz
hash        sha256:44aefc3142c5b842538163acb373e24cce6632bd54bdb01b21ad5863489f50d8

depend      filesystem
depend      python
depend      python-attrs
depend      python-rpds-py
depend      python-typing-extensions
builddep    python-hatchling

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
