name        python-charset-normalizer
version     3.5.1
release     1
arch        any
description python-charset-normalizer: The Real First Universal Charset Detector. Open, modern and actively maintained alternative to Chardet

source      https://files.pythonhosted.org/packages/e5/3f/143b048436775b0f76ac3eec145c019e8173ccc2885c8f20319b996d5e83/charset_normalizer-${version}.tar.gz
hash        sha256:6117b84ea48435e5356dc737f5121485c30920ba43375fa7b434fd753df0eac3

depend      filesystem
depend      python

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
