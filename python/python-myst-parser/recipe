name        python-myst-parser
version     5.1.0
release     1
arch        any
description python-myst-parser: An extended [CommonMark](https://spec.commonmark.org/) compliant parser,

source      https://files.pythonhosted.org/packages/21/dc/603751677fff302f34396e206b610f556a59d7fe58b9a2145f54e96b48e8/myst_parser-${version}.tar.gz
hash        sha256:ab69322dc6719dcc7f296479dbb70181b66df6ed315064f92dbc85c0e1bf2f02

depend      filesystem
depend      python
depend      python-docutils
depend      python-jinja2
depend      python-markdown-it-py
depend      python-mdit-py-plugins
depend      python-yaml
depend      python-sphinx
builddep    python-flit-core

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
