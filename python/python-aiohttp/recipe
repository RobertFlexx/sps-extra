name        python-aiohttp
version     3.14.3
release     1
arch        any
description python-aiohttp: Async http client/server framework (asyncio)

source      https://files.pythonhosted.org/packages/58/d9/22ce5786ac0c1653ae8b6c23bded02c1686d11f0dbb45b31ce128e0df985/aiohttp-${version}.tar.gz
hash        sha256:9491196535a88924a60afd5b5f434b5b203b6cc616250878dbdb223a8f7844bc

depend      filesystem
depend      python
depend      python-aiohappyeyeballs
depend      python-aiosignal
depend      python-async-timeout
depend      python-attrs
depend      python-frozenlist
depend      python-multidict
depend      python-propcache
depend      python-typing-extensions
depend      python-yarl
builddep    python-setuptools

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
