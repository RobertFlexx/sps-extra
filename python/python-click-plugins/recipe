name        python-click-plugins
version     1.1.1.2
release     1
arch        any
description python-click-plugins: An extension module for click to enable registering CLI commands via setuptools entry-points

source      https://files.pythonhosted.org/packages/c3/a4/34847b59150da33690a36da3681d6bbc2ec14ee9a846bc30a6746e5984e4/click_plugins-${version}.tar.gz
hash        sha256:d7af3984a99d243c131aa1a828331e7630f4a88a9741fd05c927b204bcf92261

depend      filesystem
depend      python
depend      python-click
builddep    python-setuptools

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
