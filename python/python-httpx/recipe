name        python-httpx
version     0.28.1
release     1
arch        any
description python-httpx: The next generation HTTP client

source      https://files.pythonhosted.org/packages/b1/df/48c586a5fe32a0f01324ee087459e112ebb7224f646c0b5023f5e79e9956/httpx-${version}.tar.gz
hash        sha256:75e98c5f16b0f35b567856f597f06ff2270a374470a5c2392242528e3e3e42fc

depend      filesystem
depend      python
depend      python-anyio
depend      python-certifi
depend      python-httpcore
depend      python-idna
builddep    python-hatchling

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
