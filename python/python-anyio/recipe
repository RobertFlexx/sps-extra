name        python-anyio
version     4.15.1
release     1
arch        any
description python-anyio: High-level concurrency and networking framework on top of asyncio or Trio

source      https://files.pythonhosted.org/packages/a9/d2/f4d173e22df740bc37b1db102b386ba719b66e95b0f0d751f556b387e6d2/anyio-${version}.tar.gz
hash        sha256:9f28306018cbd6d329e64a36d58256edff76dd996fe423bc957326e578b82a94

depend      filesystem
depend      python
depend      python-exceptiongroup
depend      python-idna
depend      python-typing-extensions
builddep    python-setuptools

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
