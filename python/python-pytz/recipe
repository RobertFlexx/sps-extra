name        python-pytz
version     2026.3.post1
release     1
arch        any
description python-pytz: World timezone definitions, modern and historical

source      https://files.pythonhosted.org/packages/fb/48/fb042503b6ca6cd271261dc559fd6432f7d8c713153e9ec5c591af4dfc1c/pytz-${version}.tar.gz
hash        sha256:2211d3fcf9a797d3405cac96ac7f61d80e6a644f72a3309607282fe8a2010c5d

depend      filesystem
depend      python
builddep    python-setuptools

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
