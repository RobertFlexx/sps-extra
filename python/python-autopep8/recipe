name        python-autopep8
version     2.3.2
release     1
arch        any
description python-autopep8: A tool that automatically formats Python code to conform to the PEP 8 style guide

source      https://files.pythonhosted.org/packages/50/d8/30873d2b7b57dee9263e53d142da044c4600a46f2d28374b3e38b023df16/autopep8-${version}.tar.gz
hash        sha256:89440a4f969197b69a995e4ce0661b031f455a9f776d2c5ba3dbd83466931758

depend      filesystem
depend      python
depend      python-pycodestyle
depend      python-tomli
builddep    python-setuptools

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
