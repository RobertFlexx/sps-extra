name        python-flask
version     3.1.3
release     1
arch        any
description python-flask: A simple framework for building complex web applications

source      https://files.pythonhosted.org/packages/26/00/35d85dcce6c57fdc871f3867d465d780f302a175ea360f62533f12b27e2b/flask-${version}.tar.gz
hash        sha256:0ef0e52b8a9cd932855379197dd8f94047b359ca0a78695144304cb45f87c9eb

depend      filesystem
depend      python
depend      python-blinker
depend      python-click
depend      python-importlib-metadata
depend      python-itsdangerous
depend      python-jinja2
depend      python-markupsafe
depend      python-werkzeug
builddep    python-flit-core

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
