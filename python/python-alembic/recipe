name        python-alembic
version     1.20.0
release     1
arch        any
description python-alembic: A database migration tool for SQLAlchemy

source      https://files.pythonhosted.org/packages/ed/aa/02910bdb8e2f1444f6654d5b296cd827d126f82209050ee7b1000f92ac4b/alembic-${version}.tar.gz
hash        sha256:db505480647bc60386c5369402f4a57a506b7539c9e9ef5e270d45cbbe4939bf

depend      filesystem
depend      python
depend      python-sqlalchemy
depend      python-mako
depend      python-typing-extensions
depend      python-tomli
builddep    python-setuptools

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
