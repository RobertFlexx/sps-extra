name        python-scipy
version     1.18.1
release     1
arch        any
description python-scipy: Fundamental algorithms for scientific computing in Python

source      https://files.pythonhosted.org/packages/7e/74/66de6258867beb2ef08f35f9f2ac017a52cacd5081714d239ff1a442d458/scipy-${version}.tar.gz
hash        sha256:52c4b7422442aba924d03ad4019852b08a92e64ea187b933135687bfe2747307

depend      filesystem
depend      python
depend      python-numpy
builddep    python-meson-python

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
