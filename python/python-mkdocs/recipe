name        python-mkdocs
version     1.6.1
release     1
arch        any
description python-mkdocs: Project documentation with Markdown

source      https://files.pythonhosted.org/packages/bc/c6/bbd4f061bd16b378247f12953ffcb04786a618ce5e904b8c5a01a0309061/mkdocs-${version}.tar.gz
hash        sha256:7b432f01d928c084353ab39c57282f29f92136665bdd6abf7c1ec8d822ef86f2

depend      filesystem
depend      python
depend      python-click
depend      python-ghp-import
depend      python-importlib-metadata
depend      python-jinja2
depend      python-markdown
depend      python-markupsafe
depend      python-mergedeep
depend      python-mkdocs-get-deps
depend      python-packaging
depend      python-pathspec
depend      python-pyyaml-env-tag
depend      python-yaml
depend      python-watchdog
builddep    python-hatchling

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
