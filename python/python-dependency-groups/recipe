name        python-dependency-groups
version     1.3.2
release     1
arch        any
description python-dependency-groups: A tool for resolving PEP 735 Dependency Group data

source      https://files.pythonhosted.org/packages/b5/16/65e61d8e837e0d70a99a0d4dd76e2af53357c3a03ed1db8ad9b5786d7f25/dependency_groups-${version}.tar.gz
hash        sha256:c81831f43828dbc3987ee247eb198241a0152b8e7ceab10977cc3808eb388ac7

depend      filesystem
depend      python
depend      python-packaging
depend      python-tomli
builddep    python-flit-core

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
