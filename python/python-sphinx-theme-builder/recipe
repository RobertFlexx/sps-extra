name        python-sphinx-theme-builder
version     0.3.2
release     1
arch        any
description python-sphinx-theme-builder: A tool for authoring Sphinx themes with a simple (opinionated) workflow

source      https://files.pythonhosted.org/packages/df/e7/bedb9957063daf682fcdac609d5649fb6b953b04557dd2e1821832fbc7e8/sphinx_theme_builder-${version}.tar.gz
hash        sha256:40b4bc2275b04d76781722c2e597770159e512f166986e1ceca1580a693f27bb

depend      filesystem
depend      python
depend      python-pyproject-metadata
depend      python-packaging
depend      python-rich
depend      python-nodeenv
depend      python-setuptools
depend      python-tomli
depend      python-diagnostic
builddep    python-flit-core

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
