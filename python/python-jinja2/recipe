name        python-jinja2
version     3.1.6
release     1
arch        any
description python-jinja2: A very fast and expressive template engine

source      https://files.pythonhosted.org/packages/df/bf/f7da0350254c0ed7c72f3e33cef02e048281fec7ecec5f032d4aac52226b/jinja2-${version}.tar.gz
hash        sha256:0137fb05990d35f1275a587e9aee6d56da821fc83491a0fb838183be43f66d6d

depend      filesystem
depend      python
depend      python-markupsafe
builddep    python-flit-core

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
