name        python-hatch-vcs
version     0.5.0
release     1
arch        any
description python-hatch-vcs: Hatch plugin for versioning with your preferred VCS

source      https://files.pythonhosted.org/packages/6b/b0/4cc743d38adbee9d57d786fa496ed1daadb17e48589b6da8fa55717a0746/hatch_vcs-${version}.tar.gz
hash        sha256:0395fa126940340215090c344a2bf4e2a77bcbe7daab16f41b37b98c95809ff9

depend      filesystem
depend      python
depend      python-hatchling
depend      python-setuptools-scm
builddep    python-hatchling

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
