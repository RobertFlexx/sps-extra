name        python-platformdirs
version     4.11.12
release     1
arch        any
description python-platformdirs: A small Python package for determining appropriate platform-specific dirs, e.g. a `user data dir`

source      https://files.pythonhosted.org/packages/ea/dd/65804b0c2925a1c821a05502ea57517b69a073ff400d25ab9faa3a2cf012/platformdirs-${version}.tar.gz
hash        sha256:e8dc1cb58f1153fd7f61db1374317770baababec2480b37b8f01c6cc25b45267

depend      filesystem
depend      python
builddep    python-hatchling

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
