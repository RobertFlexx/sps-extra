name        python-mpmath
version     1.4.1
release     1
arch        any
description python-mpmath: Python library for arbitrary-precision floating-point arithmetic

source      https://files.pythonhosted.org/packages/c5/b0/6de8e78014ff1842a90cc9a56da6ccfb598a5390ed0257fcdb7d9680c18b/mpmath-${version}.tar.gz
hash        sha256:efd6d1b75f09d69524a67609949812668b28e81ecbfe0ab449ced8c13e92642e

depend      filesystem
depend      python
builddep    python-setuptools

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
