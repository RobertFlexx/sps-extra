name        python-jsonschema
version     4.26.0
release     1
arch        any
description python-jsonschema: An implementation of JSON Schema validation for Python

source      https://files.pythonhosted.org/packages/b3/fc/e067678238fa451312d4c62bf6e6cf5ec56375422aee02f9cb5f909b3047/jsonschema-${version}.tar.gz
hash        sha256:0c26707e2efad8aa1bfc5b7ce170f3fccc2e4918ff85989ba9ffa9facb2be326

depend      filesystem
depend      python
depend      python-attrs
depend      python-jsonschema-specifications
depend      python-referencing
depend      python-rpds-py
builddep    python-hatchling

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
