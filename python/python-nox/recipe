name        python-nox
version     2026.8.17
release     1
arch        any
description python-nox: Flexible test automation

source      https://files.pythonhosted.org/packages/be/65/4cef8ae8f6dbcb5753b202e46791277f1ea0b4a0650d1a6cb940c468b143/nox-${version}.tar.gz
hash        sha256:8d9c69c9b996a59db1eb2c6968deaebc2edbc55317d205981bbc4a37351d3f2e

depend      filesystem
depend      python
depend      python-argcomplete
depend      python-attrs
depend      python-colorlog
depend      python-dependency-groups
depend      python-humanize
depend      python-packaging
depend      python-platformdirs
depend      python-discovery
depend      python-tomli
depend      python-virtualenv
builddep    python-hatchling

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
