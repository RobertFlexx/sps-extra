name        python-deepdiff
version     9.1.0
release     1
arch        any
description python-deepdiff: Deep Difference and Search of any Python object/data. Recreate objects by adding adding deltas to each other

source      https://files.pythonhosted.org/packages/f9/6b/6a4a5aaf38535eb332c2856aa08e73ed7c549d0851b1215401af0a2db1a7/deepdiff-${version}.tar.gz
hash        sha256:07e9e366fab4297755153c4eab795ad4ef3cbd0d51660e847f5751c6bd727687

depend      filesystem
depend      python
depend      python-cachebox
depend      python-orderly-set
builddep    python-flit-core

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
