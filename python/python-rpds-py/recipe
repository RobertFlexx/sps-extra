name        python-rpds-py
version     2026.6.3
release     1
arch        any
description python-rpds-py: Python bindings to Rust's persistent data structures (rpds)

source      https://files.pythonhosted.org/packages/aa/2a/9618a122aeb2a169a28b03889a2995fe297588964333d4a7d67bdf46e147/rpds_py-${version}.tar.gz
hash        sha256:1cebd1337c242e4ec2293e541f712b2da849b29f48f0c293684b71c0632625d4

depend      filesystem
depend      python
builddep    python-maturin

install     python3 -m pip install --no-deps --no-build-isolation --no-compile --root="$PKG" --prefix=/usr .
install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); \
            if [ -d "$PKG/usr/lib/python$pyver" ]; then \
            mkdir -p "$PKG/usr/lib64"; \
            cp -a "$PKG/usr/lib/python$pyver/." "$PKG/usr/lib64/python$pyver/"; \
            rm -rf "$PKG/usr/lib/python$pyver"; \
            rmdir "$PKG/usr/lib" 2>/dev/null || :; fi
