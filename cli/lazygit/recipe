name        lazygit
version     0.64.1
release     1
description lazygit: terminal UI for git

source      https://github.com/jesseduffield/lazygit/archive/refs/tags/v0.64.1.tar.gz
hash        sha256:b1df6ee72f17efc0ef95fc20a64821cd9eda3935b81cb98b1719c8266163bd07

depend      filesystem
builddep    go

build       GOPROXY=https://proxy.golang.org,direct CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o "lazygit"
install     mkdir -p "$PKG/usr/bin"
install     cp "lazygit" "$PKG/usr/bin/lazygit"
install     chmod 755 "$PKG/usr/bin/lazygit"
