name        lf
version     34
release     1
description lf: terminal file manager

source      https://github.com/gokcehan/lf/archive/r34.tar.gz
hash        sha256:9c78735fa88c0b77664d7de41e7edbbca99ace5410f522530307244a09839263

depend      filesystem
builddep    go

build       GOPROXY=https://proxy.golang.org,direct CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o lf .
install     mkdir -p "$PKG/usr/bin"
install     cp lf "$PKG/usr/bin/lf"
install     chmod 755 "$PKG/usr/bin/lf"
