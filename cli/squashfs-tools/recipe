name        squashfs-tools
version     4.6.1
release     1
description squashfs-tools: squashfs image tools

source      https://github.com/plougher/squashfs-tools/archive/refs/tags/4.6.1.tar.gz
hash        sha256:9c4974e07c61547dae14af4ed1f358b7d04618ae194e54d6be72ee126f0d2f53

depend      filesystem
depend      zlib
depend      xz
depend      lz4
depend      zstd
depend      lzo

build       make -j"$MAKEJOBS" -C squashfs-tools XZ_SUPPORT=1 LZ4_SUPPORT=1 ZSTD_SUPPORT=1 LZO_SUPPORT=1
install     make -C squashfs-tools INSTALL_DIR="$PKG/usr/bin" install
