name        direnv
version     2.37.1
release     1
description direnv: directory-based environment

source      https://github.com/direnv/direnv/archive/refs/tags/v2.37.1.tar.gz
hash        sha256:4142fbb661f3218913fac08d327c415e87b3e66bd0953185294ff8f3228ead24

depend      filesystem
builddep    go

build       GOPROXY=https://proxy.golang.org,direct CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o direnv .
install     mkdir -p "$PKG/usr/bin"
install     cp direnv "$PKG/usr/bin/direnv"
install     chmod 755 "$PKG/usr/bin/direnv"
