name        caddy
version     2.10.0
release     2
description caddy: HTTP server

source      https://github.com/caddyserver/caddy/releases/download/v2.10.0/caddy_2.10.0_linux_amd64.tar.gz
hash        sha256:43f22cf5b4dffb123c3c984023f0817f44d9ace93749d64cfffe124016595722

depend      filesystem

install     mkdir -p "$PKG/usr/bin"
install     cp caddy "$PKG/usr/bin/caddy"
install     chmod 755 "$PKG/usr/bin/caddy"
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d" "$PKG/etc/sv/caddy" "$PKG/etc/s6/sv/caddy" "$PKG/etc/dinit.d" "$PKG/etc/shepherd.d" "$PKG/etc/rc.d/init.d"
install     install -m 0644 "$SRC/files/caddy.service" "$PKG/usr/lib/systemd/system/caddy.service"
install     install -m 0755 "$SRC/files/openrc-caddy" "$PKG/etc/init.d/caddy"
install     install -m 0755 "$SRC/files/runit-caddy" "$PKG/etc/sv/caddy/run"
install     install -m 0755 "$SRC/files/s6-caddy" "$PKG/etc/s6/sv/caddy/run"
install     install -m 0644 "$SRC/files/dinit-caddy" "$PKG/etc/dinit.d/caddy"
install     install -m 0644 "$SRC/files/shepherd-caddy.scm" "$PKG/etc/shepherd.d/caddy.scm"
install     install -m 0755 "$SRC/files/sysvinit-caddy" "$PKG/etc/rc.d/init.d/caddy"
