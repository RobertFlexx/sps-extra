name        fastfetch
version     2.67.1
release     2
description fastfetch: system information

source      https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/2.67.1.tar.gz
hash        sha256:52489550d1fdeac8bde8b3442064e3bc78d28fda752a171dc46a6cd97454f237

depend      filesystem
builddep    cmake
builddep    ninja
builddep    patch

prepare     patch -Np1 -i "$SRC/patches/sps-package-detection.patch"
configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
