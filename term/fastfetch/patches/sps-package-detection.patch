 }
 
+
+static uint32_t getSpsPackages(FFstrbuf* baseDir)
+{
+    uint32_t baseDirLength = baseDir->length;
+    ffStrbufAppendS(baseDir, "/var/lib/sps/installed");
+
+    FF_AUTO_CLOSE_DIR DIR* dirp = opendir(baseDir->chars);
+    if (dirp == nullptr)
+    {
+        ffStrbufSubstrBefore(baseDir, baseDirLength);
+        return 0;
+    }
+
+    uint32_t count = 0;
+    struct dirent* entry;
+    while ((entry = readdir(dirp)) != nullptr)
+    {
+        if (entry->d_name[0] == '.')
+            continue;
+
+        struct stat stbuf;
+        if (fstatat(dirfd(dirp), entry->d_name, &stbuf, AT_SYMLINK_NOFOLLOW) != 0)
+            continue;
+        if (!S_ISDIR(stbuf.st_mode))
+            continue;
+
+        FF_STRBUF_AUTO_DESTROY metaName = ffStrbufCreateS(entry->d_name);
+        ffStrbufAppendS(&metaName, "/meta");
+        if (fstatat(dirfd(dirp), metaName.chars, &stbuf, AT_SYMLINK_NOFOLLOW) != 0)
+            continue;
+        if (!S_ISREG(stbuf.st_mode))
+            continue;
+        ++count;
+    }
+
+    ffStrbufSubstrBefore(baseDir, baseDirLength);
+    return count;
+}
+
 static void getPackageCounts(FFstrbuf* baseDir, FFPackagesResult* packageCounts, FFPackagesOptions* options) {
     if (FF_PACKAGES_IS_ENABLED(options, APK)) {
         packageCounts->apk += getNumStrings(baseDir, "/lib/apk/db/installed", "C:Q", "apk");
@@ -547,6 +586,9 @@
     if (FF_PACKAGES_IS_ENABLED(options, SORCERY)) {
         packageCounts->sorcery += getNumStrings(baseDir, "/var/state/sorcery/packages", ":installed:", "sorcery");
     }
+    if (FF_PACKAGES_IS_ENABLED(options, SPS)) {
+        packageCounts->sps += getSpsPackages(baseDir);
+    }
     if (FF_PACKAGES_IS_ENABLED(options, GUIX)) {
         packageCounts->guixSystem += getGuixPackages(baseDir, "/run/current-system/profile");
     }
