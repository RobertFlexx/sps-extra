name        wl-clipboard
version     2.2.1
release     1
description wl-clipboard: clipboard for Wayland

source      https://github.com/bugaevc/wl-clipboard/archive/v2.2.1.tar.gz
hash        sha256:6eb8081207fb5581d1d82c4bcd9587205a31a3d47bea3ebeb7f41aa1143783eb

depend      filesystem
depend      wayland
depend      wayland-protocols
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release
build       meson compile -C build -j "$MAKEJOBS"
install     DESTDIR="$PKG" meson install -C build
