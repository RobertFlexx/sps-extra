name        grim
version     1.4.1
release     1
description grim: screenshot tool for Wayland

source      https://gitlab.freedesktop.org/emersion/grim/-/archive/v1.4.1/grim-v1.4.1.tar.gz
hash        sha256:5ed8e70fcd83a7e203e92d34dbb82a1342d3f13ad98a6b0310cc97e1a9342ded

depend      filesystem
depend      wayland
depend      wayland-protocols
depend      pixman
depend      libpng
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release
build       meson compile -C build -j "$MAKEJOBS"
install     DESTDIR="$PKG" meson install -C build
