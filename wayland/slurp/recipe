name        slurp
version     1.5.0
release     1
description slurp: select a region on Wayland

source      https://github.com/emersion/slurp/archive/v1.5.0.tar.gz
hash        sha256:0fa880d4a93e1c795e3b5929fbea47546df0955bea34fc2f7ffeb1751678f663

depend      filesystem
depend      wayland
depend      wayland-protocols
depend      cairo
depend      libxkbcommon
builddep    meson
builddep    ninja

configure   meson setup build --prefix=/usr --libdir=lib64 --buildtype=release
build       meson compile -C build -j "$MAKEJOBS"
install     DESTDIR="$PKG" meson install -C build
