name        mold
version     2.40.4
release     1
description mold: high-performance linker

source      https://github.com/rui314/mold/archive/refs/tags/v2.40.4.tar.gz
hash        sha256:69414c702ec1084e1fa8ca16da24f167f549e5e11e9ecd5d70a8dcda6f08c249

depend      filesystem
depend      zlib
depend      zstd
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DMOLD_USE_MIMALLOC=OFF -DMOLD_USE_SYSTEM_TBB=OFF
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
