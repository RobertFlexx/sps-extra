name        git-lfs
version     3.6.1
release     1
description git-lfs: Git Large File Storage

source      https://github.com/git-lfs/git-lfs/releases/download/v3.6.1/git-lfs-linux-amd64-v3.6.1.tar.gz
hash        sha256:2138d2e405a12f1a088272e06790b76699b79cb90d0317b77aafaf35de908d76

depend      filesystem
depend      git

install     mkdir -p "$PKG/usr/bin"
install     find . -type f -name git-lfs -exec cp {} "$PKG/usr/bin/git-lfs" \;
install     chmod 755 "$PKG/usr/bin/git-lfs"
