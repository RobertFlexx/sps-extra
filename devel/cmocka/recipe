name        cmocka
version     1.1.8
release     1
description cmocka: unit testing for C

source      https://cmocka.org/files/1.1/cmocka-1.1.8.tar.xz
hash        sha256:58435b558766d7f4c729ba163bdf3aec38bed3bc766dab684e3526ed0aa7c780

depend      filesystem
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -DUNIT_TESTING=OFF
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
