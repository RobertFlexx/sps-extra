name        toolchains
version     1.0
release     1
arch        any
description toolchains: assemblers, linkers, and extra C compilers

depend      filesystem
depend      binutils
depend      nasm
depend      yasm
depend      tcc
depend      fpc
depend      zig
depend      mold
depend      rookcc

install     mkdir -p "$PKG/usr/share/sps/sets"
install     printf '%s\n' "toolchains" >"$PKG/usr/share/sps/sets/toolchains"
