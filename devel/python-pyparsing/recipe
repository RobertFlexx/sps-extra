install     pyver=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])'); mkdir -p "$PKG/usr/lib/python$pyver/site-packages"; cp -a pyparsing "$PKG/usr/lib/python$pyver/site-packages/"
