name        gdb
version     17.1
release     1
description gdb: GNU debugger

source      https://ftp.gnu.org/gnu/gdb/gdb-17.1.tar.xz
hash        sha256:14996f5f74c9f68f5a543fdc45bca7800207f91f92aeea6c2e791822c7c6d876

depend      filesystem
depend      ncurses
depend      readline
depend      python
depend      expat
depend      zlib
depend      xz

configure   ./configure --prefix=/usr --with-system-readline --with-python=/usr/bin/python3 --disable-nls
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
