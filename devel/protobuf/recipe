name        protobuf
version     29.3
release     1
description protobuf: Protocol Buffers

source      https://github.com/protocolbuffers/protobuf/releases/download/v29.3/protobuf-29.3.tar.gz
hash        sha256:008a11cc56f9b96679b4c285fd05f46d317d685be3ab524b2a310be0fbad987e

depend      filesystem
depend      zlib
builddep    cmake
builddep    ninja

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=lib64 -Dprotobuf_BUILD_TESTS=OFF -Dprotobuf_BUILD_SHARED_LIBS=ON
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
