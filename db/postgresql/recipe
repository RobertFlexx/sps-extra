name        postgresql
version     17.6
release     3
description postgresql: object-relational database

source      https://ftp.postgresql.org/pub/source/v17.6/postgresql-17.6.tar.bz2
hash        sha256:e0630a3600aea27511715563259ec2111cd5f4353a4b040e0be827f94cd7a8b0

depend      filesystem
depend      openssl
depend      zlib
depend      readline
depend      icu
depend      libxml2
depend      lz4
depend      zstd

configure   ./configure --prefix=/usr --with-openssl --with-libxml --with-icu --with-lz4 --with-zstd --with-uuid=e2fs
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d" "$PKG/etc/sv/postgresql" "$PKG/etc/s6/sv/postgresql" "$PKG/etc/dinit.d" "$PKG/etc/shepherd.d" "$PKG/etc/rc.d/init.d"
install     install -m 0644 "$SRC/files/postgresql.service" "$PKG/usr/lib/systemd/system/postgresql.service"
install     install -m 0755 "$SRC/files/openrc-postgresql" "$PKG/etc/init.d/postgresql"
install     install -m 0755 "$SRC/files/runit-postgresql" "$PKG/etc/sv/postgresql/run"
install     install -m 0755 "$SRC/files/s6-postgresql" "$PKG/etc/s6/sv/postgresql/run"
install     install -m 0644 "$SRC/files/dinit-postgresql" "$PKG/etc/dinit.d/postgresql"
install     install -m 0644 "$SRC/files/shepherd-postgresql.scm" "$PKG/etc/shepherd.d/postgresql.scm"
install     install -m 0755 "$SRC/files/sysvinit-postgresql" "$PKG/etc/rc.d/init.d/postgresql"
