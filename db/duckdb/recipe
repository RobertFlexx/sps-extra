name        duckdb
version     1.3.2
release     1
description duckdb: in-process analytical database

source      https://github.com/duckdb/duckdb/releases/download/v1.3.2/duckdb_cli-linux-amd64.zip
hash        sha256:682ff48f988cb6f054fe42e755b7037ade3441e7a406cce3180b05ac0287279d

depend      filesystem
builddep    unzip

install     mkdir -p "$PKG/usr/bin"
install     unzip -o -d "$WORK/bin-unpack" "$SRC/"*.zip
install     find "$WORK/bin-unpack" -type f -name duckdb -exec cp {} "$PKG/usr/bin/duckdb" \;
install     chmod 755 "$PKG/usr/bin/duckdb"
