name        cups
version     2.4.14
release     3
description cups: Common UNIX Printing System

source      https://github.com/OpenPrinting/cups/releases/download/v2.4.14/cups-2.4.14-source.tar.gz
hash        sha256:660288020dd6f79caf799811c4c1a3207a48689899ac2093959d70a3bdcb7699

depend      filesystem
depend      openssl
depend      zlib

configure   ./configure --prefix=/usr --with-rcdir=no --with-systemd=no --with-components=all
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d" "$PKG/etc/sv/cupsd" "$PKG/etc/s6/sv/cupsd" "$PKG/etc/dinit.d" "$PKG/etc/shepherd.d" "$PKG/etc/rc.d/init.d"
install     install -m 0644 "$SRC/files/cups.service" "$PKG/usr/lib/systemd/system/cups.service"
install     install -m 0755 "$SRC/files/openrc-cupsd" "$PKG/etc/init.d/cupsd"
install     install -m 0755 "$SRC/files/runit-cupsd" "$PKG/etc/sv/cupsd/run"
install     install -m 0755 "$SRC/files/s6-cupsd" "$PKG/etc/s6/sv/cupsd/run"
install     install -m 0644 "$SRC/files/dinit-cupsd" "$PKG/etc/dinit.d/cupsd"
install     install -m 0644 "$SRC/files/shepherd-cupsd.scm" "$PKG/etc/shepherd.d/cupsd.scm"
install     install -m 0755 "$SRC/files/sysvinit-cupsd" "$PKG/etc/rc.d/init.d/cupsd"
