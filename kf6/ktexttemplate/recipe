name        ktexttemplate
version     6.26.0
release     1
description ktexttemplate: KDE component

source      https://download.kde.org/stable/frameworks/6.26/ktexttemplate-6.26.0.tar.xz
hash        sha256:8b84643c32caf58812fec5a910a1fb98865bc7f91e778af860fa98b79d0ff038

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
