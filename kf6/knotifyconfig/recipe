name        knotifyconfig
version     6.26.0
release     1
description knotifyconfig: KDE component

source      https://download.kde.org/stable/frameworks/6.26/knotifyconfig-6.26.0.tar.xz
hash        sha256:062e22f48a1da485d42ef56b37db1fc502f5f9305871483627d218f357560a28

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
