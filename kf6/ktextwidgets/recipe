name        ktextwidgets
version     6.26.0
release     1
description ktextwidgets: KDE component

source      https://download.kde.org/stable/frameworks/6.26/ktextwidgets-6.26.0.tar.xz
hash        sha256:6511f9909f90fac951e2873a44dd451b8ac71d38085a62c65a6fb5028e62d84d

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
