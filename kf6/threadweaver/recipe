name        threadweaver
version     6.26.0
release     1
description threadweaver: KDE component

source      https://download.kde.org/stable/frameworks/6.26/threadweaver-6.26.0.tar.xz
hash        sha256:ad32daeafac62077590885f3abc4bcac1abbc6faeb34c20b32f6040648f7de1b

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
