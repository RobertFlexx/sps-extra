name        kdnssd
version     6.26.0
release     1
description kdnssd: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kdnssd-6.26.0.tar.xz
hash        sha256:8439daed9c4b942a74393daf23c8d97fdaabd81b93dc347f91bbb45a2bf85248

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
