name        modemmanager-qt
version     6.26.0
release     1
description modemmanager-qt: KDE component

source      https://download.kde.org/stable/frameworks/6.26/modemmanager-qt-6.26.0.tar.xz
hash        sha256:bef456ac0a5983bcc14a1580cb0d32a001241f380d901cb503613855380af3a5

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
