name        frameworkintegration
version     6.26.0
release     1
description frameworkintegration: KDE component

source      https://download.kde.org/stable/frameworks/6.26/frameworkintegration-6.26.0.tar.xz
hash        sha256:84ebbad39b559e271bcec4817eba9124903ca660ad4f5c3f73f21a5f4a32062d

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
