name        solid
version     6.26.0
release     1
description solid: KDE component

source      https://download.kde.org/stable/frameworks/6.26/solid-6.26.0.tar.xz
hash        sha256:85cfab9b0787f59478661140997c485fadab62cec535ffcef2953d312f736c4a

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
