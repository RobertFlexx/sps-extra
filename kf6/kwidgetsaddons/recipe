name        kwidgetsaddons
version     6.26.0
release     1
description kwidgetsaddons: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kwidgetsaddons-6.26.0.tar.xz
hash        sha256:65044882e30b305fe9fb20331a354cd811ca9d80b5c7f9fa722639f3334fe630

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
