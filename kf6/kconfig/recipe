name        kconfig
version     6.26.0
release     1
description kconfig: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kconfig-6.26.0.tar.xz
hash        sha256:8bb5aa918d8e60ec140a33db3c329414d2319dc97a1644b368da5576125c92b5

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
