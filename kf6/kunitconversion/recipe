name        kunitconversion
version     6.26.0
release     1
description kunitconversion: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kunitconversion-6.26.0.tar.xz
hash        sha256:94404453011eec373f858ef4a58091d24fbadbb90f96bbbf470c098646d9675e

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
