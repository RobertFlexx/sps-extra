name        kauth
version     6.26.0
release     1
description kauth: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kauth-6.26.0.tar.xz
hash        sha256:e6b6562114c2cb71db6ca48fdf0ebed2df70e164c48295b35433a80b03385847

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
