name        kconfigwidgets
version     6.26.0
release     1
description kconfigwidgets: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kconfigwidgets-6.26.0.tar.xz
hash        sha256:3babcef22aea293fad0db65fcdbf76eb4ac9077bc758ee8daec108090242ea3c

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
