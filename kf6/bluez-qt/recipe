name        bluez-qt
version     6.26.0
release     1
description bluez-qt: KDE component

source      https://download.kde.org/stable/frameworks/6.26/bluez-qt-6.26.0.tar.xz
hash        sha256:ebeb301eaeb6ec6729b27969556839165ba582ebe242b42cde71c8faa80d63df

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
