name        kholidays
version     6.26.0
release     1
description kholidays: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kholidays-6.26.0.tar.xz
hash        sha256:fc4f46cb5bb8e4766f550fe1a8b401731d797fcf6afa7cb53679048c215a60be

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
