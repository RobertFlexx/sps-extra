name        kxmlgui
version     6.26.0
release     1
description kxmlgui: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kxmlgui-6.26.0.tar.xz
hash        sha256:4383855cea5a7f9a269c72dda15490b8d70c1d23d17950963937332fc5d6b7a0

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
