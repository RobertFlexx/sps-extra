name        sonnet
version     6.26.0
release     1
description sonnet: KDE component

source      https://download.kde.org/stable/frameworks/6.26/sonnet-6.26.0.tar.xz
hash        sha256:3ac4e165c0b3c79eda416b754bb837292f354188a1220f2065f57f686489af25

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
