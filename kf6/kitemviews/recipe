name        kitemviews
version     6.26.0
release     1
description kitemviews: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kitemviews-6.26.0.tar.xz
hash        sha256:e76cc9d7561d0aae22b07a77552fbcddf61c8066bac5cfac9958ac065b617e74

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
