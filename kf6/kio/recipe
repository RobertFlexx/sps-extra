name        kio
version     6.26.0
release     1
description kio: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kio-6.26.0.tar.xz
hash        sha256:567f64db9766986b5535d884a5db30203685c33e67f56892bceff30e1bd5cc8a

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
