name        kdoctools
version     6.26.0
release     1
description kdoctools: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kdoctools-6.26.0.tar.xz
hash        sha256:3fbea5de215076130007f3c18e16b870774ffa4fc85ddace201ac020d0245fb6

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
