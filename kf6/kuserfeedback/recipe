name        kuserfeedback
version     6.26.0
release     1
description kuserfeedback: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kuserfeedback-6.26.0.tar.xz
hash        sha256:6cc18dca65a24af2ac262cb9c8761991701c8081a7133487b4ec936003f3f864

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
