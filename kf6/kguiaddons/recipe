name        kguiaddons
version     6.26.0
release     1
description kguiaddons: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kguiaddons-6.26.0.tar.xz
hash        sha256:8375342f852104f36fd72a6870eb9795183af4516592cd6fa73445ea6b813172

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
