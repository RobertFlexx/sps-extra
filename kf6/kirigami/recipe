name        kirigami
version     6.26.0
release     1
description kirigami: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kirigami-6.26.0.tar.xz
hash        sha256:b268785b271198acec7fe4b6177eafdee890e180245c7168916da3ccff1425ff

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
