name        kpeople
version     6.26.0
release     1
description kpeople: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kpeople-6.26.0.tar.xz
hash        sha256:bd1092cd9900d0ee3b3d08d0971e669a82d1a11c9bec6e2322d713b59191b873

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
