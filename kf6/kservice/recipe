name        kservice
version     6.26.0
release     1
description kservice: KDE component

source      https://download.kde.org/stable/frameworks/6.26/kservice-6.26.0.tar.xz
hash        sha256:f8528524ccafb6a495962dd3260c442377920169f1c444f11657ea42558a53b6

depend      filesystem
depend      qt6
builddep    cmake
builddep    ninja
builddep    extra-cmake-modules

configure   cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DKDE_INSTALL_LIBDIR=lib
build       cmake --build build --parallel "$MAKEJOBS"
install     DESTDIR="$PKG" cmake --install build
