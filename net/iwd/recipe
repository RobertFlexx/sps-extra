name        iwd
version     3.9
release     2
description iwd: iNet wireless daemon

source      https://cdn.kernel.org/pub/linux/network/wireless/iwd-3.9.tar.xz
hash        sha256:0cd7dc9b32b9d6809a4a5e5d063b5c5fd279f5ad3a0bf03d7799da66df5cad45

depend      filesystem
depend      ell
depend      dbus

configure   ./configure --prefix=/usr --disable-systemd-service
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d"
install     install -m 0644 "$SRC/files/iwd.service" "$PKG/usr/lib/systemd/system/iwd.service"
install     install -m 0755 "$SRC/files/openrc-iwd" "$PKG/etc/init.d/iwd"
