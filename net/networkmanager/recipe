name        networkmanager
version     1.54.0
release     3
description networkmanager: network configuration

source      https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/archive/1.54.0/NetworkManager-1.54.0.tar.gz
hash        sha256:c5356e5a86b351dc79d23c8685d02b91917d1f107628c97d370c6441a8322a93

depend      filesystem
depend      glib
depend      dbus
depend      libndp
depend      jansson

configure   meson setup build --prefix=/usr --buildtype=release -Dsystemd=false -Dsession_tracking=elogind -Dtests=no
build       meson compile -C build
install     DESTDIR="$PKG" meson install -C build --no-rebuild
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d" "$PKG/etc/sv/NetworkManager" "$PKG/etc/s6/sv/NetworkManager" "$PKG/etc/dinit.d" "$PKG/etc/shepherd.d" "$PKG/etc/rc.d/init.d"
install     install -m 0644 "$SRC/files/NetworkManager.service" "$PKG/usr/lib/systemd/system/NetworkManager.service"
install     install -m 0755 "$SRC/files/openrc-NetworkManager" "$PKG/etc/init.d/NetworkManager"
install     install -m 0755 "$SRC/files/runit-NetworkManager" "$PKG/etc/sv/NetworkManager/run"
install     install -m 0755 "$SRC/files/s6-NetworkManager" "$PKG/etc/s6/sv/NetworkManager/run"
install     install -m 0644 "$SRC/files/dinit-NetworkManager" "$PKG/etc/dinit.d/NetworkManager"
install     install -m 0644 "$SRC/files/shepherd-NetworkManager.scm" "$PKG/etc/shepherd.d/NetworkManager.scm"
install     install -m 0755 "$SRC/files/sysvinit-NetworkManager" "$PKG/etc/rc.d/init.d/NetworkManager"
