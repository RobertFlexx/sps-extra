name        bluez
version     5.84
release     2
description bluez: Bluetooth protocol stack

source      https://mirrors.edge.kernel.org/pub/linux/bluetooth/bluez-5.84.tar.xz
hash        sha256:5ba73d030f7b00087d67800b0e321601aec0f892827c72e5a2c8390d8c886b11

depend      filesystem
depend      dbus
depend      glib
depend      libical
depend      readline

configure   ./configure --prefix=/usr --enable-library --disable-systemd --disable-manpages
build       make -j"$MAKEJOBS"
install     make install DESTDIR="$PKG"
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d"
install     install -m 0644 "$SRC/files/bluetooth.service" "$PKG/usr/lib/systemd/system/bluetooth.service"
install     install -m 0755 "$SRC/files/openrc-bluetooth" "$PKG/etc/init.d/bluetooth"
