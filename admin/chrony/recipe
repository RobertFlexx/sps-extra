name        chrony
version     4.6.1
release     2
description chrony: NTP client and server

source      https://chrony-project.org/releases/chrony-4.6.1.tar.gz
hash        sha256:571ff73fbf0ae3097f0604eca2e00b1d8bb2e91affe1a3494785ff21d6199c5c

depend      filesystem
depend      libcap
depend      nettle

configure   ./configure --prefix=/usr --sysconfdir=/etc --chronyd-user=chrony
build       make -j"$MAKEJOBS"
install     make DESTDIR="$PKG" install
install     mkdir -p "$PKG/usr/lib/systemd/system" "$PKG/etc/init.d" "$PKG/etc/sv/chronyd" "$PKG/etc/s6/sv/chronyd" "$PKG/etc/dinit.d" "$PKG/etc/shepherd.d" "$PKG/etc/rc.d/init.d"
install     install -m 0644 "$SRC/files/chronyd.service" "$PKG/usr/lib/systemd/system/chronyd.service"
install     install -m 0755 "$SRC/files/openrc-chronyd" "$PKG/etc/init.d/chronyd"
install     install -m 0755 "$SRC/files/runit-chronyd" "$PKG/etc/sv/chronyd/run"
install     install -m 0755 "$SRC/files/s6-chronyd" "$PKG/etc/s6/sv/chronyd/run"
install     install -m 0644 "$SRC/files/dinit-chronyd" "$PKG/etc/dinit.d/chronyd"
install     install -m 0644 "$SRC/files/shepherd-chronyd.scm" "$PKG/etc/shepherd.d/chronyd.scm"
install     install -m 0755 "$SRC/files/sysvinit-chronyd" "$PKG/etc/rc.d/init.d/chronyd"
