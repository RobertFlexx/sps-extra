name        colordiff
version     1.0.21
release     1
arch        any
description colordiff: colorize diff output

source      https://www.colordiff.org/colordiff-1.0.21.tar.gz
hash        sha256:9b30f4257ef0f0806dea5a27c9ad8edc3f7999f05ddaff6f0627064dc927e615

depend      filesystem

install     mkdir -p "$PKG/usr/bin" "$PKG/etc" "$PKG/usr/share/man/man1"
install     cp colordiff.pl "$PKG/usr/bin/colordiff"
install     chmod 755 "$PKG/usr/bin/colordiff"
install     if [ -f cdiff.sh ]; then cp cdiff.sh "$PKG/usr/bin/cdiff"; chmod 755 "$PKG/usr/bin/cdiff"; fi
install     if [ -f colordiffrc ]; then cp colordiffrc "$PKG/etc/colordiffrc"; fi
install     if [ -f colordiff.1 ]; then cp colordiff.1 "$PKG/usr/share/man/man1/colordiff.1"; fi
